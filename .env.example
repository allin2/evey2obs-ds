# Claude Code + DeepSeek V4 Pro reference configuration.
# Non-secret values are fixed in .claude/settings.json. Keep the real token in user settings.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro

# evey2obs application LLM configuration. Never commit real credentials.
EVEY2OBS_LLM_PROTOCOL=openai
EVEY2OBS_LLM_BASE_URL=
EVEY2OBS_LLM_API_KEY=
EVEY2OBS_LLM_MODEL=

# Local transcription.
EVEY2OBS_WHISPER_MODEL=small

# Obsidian output.
EVEY2OBS_OBSIDIAN_VAULT=
EVEY2OBS_OBSIDIAN_SUBDIR=Inbox/evey2obs
EVEY2OBS_OBSIDIAN_ATTACHMENT_SUBDIR=_attachments/evey2obs

# Optional network/platform settings.
EVEY2OBS_PROXY=
EVEY2OBS_COOKIES_FROM_BROWSER=
EVEY2OBS_COOKIES_FILE=

# Runtime behavior.
EVEY2OBS_LOG_LEVEL=INFO
EVEY2OBS_TEMP_RETENTION_HOURS=24
# Optional parent directory for reusable transcript cache.
EVEY2OBS_CACHE_DIR=
# Optional parent directory for recoverable local results when Vault export fails.
EVEY2OBS_RECOVERY_DIR=
# Default summary scenario template (general, course, meeting, short_video, article)
EVEY2OBS_SUMMARY_TEMPLATE=general

